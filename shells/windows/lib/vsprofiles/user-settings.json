{
    "update.mode": "manual",
    "update.enableWindowsBackgroundUpdates": false,
    "extensions.autoUpdate": false,
    "extensions.ignoreRecommendations": true,
    "settingsSync.enabled": false,
    "settingsSync.keybindingsPerPlatform": false,
    "settingsSync.ignoredSettings": ["extensions"],
    "settingsSync.enableBackupSettings": false,
    "window.newWindowProfile": "",
    "window.restoreWindows": "none",
    "github.gitProtocol": "ssh",
    "security.restrictUNCAccess": false,
    "ltex.language": "en-US",
    "ltex.configurationTarget": {
        "dictionary": "workspaceFolderExternalFile",
        "disabledRules": "workspaceFolderExternalFile",
        "hiddenFalsePositives": "workspaceFolderExternalFile"
    },
    "vim.insertModeKeyBindings": [
        { "before": ["j", "j"], "after": ["<Esc>"] }
    ],
    "vim.normalModeKeyBindingsNonRecursive": [
        { "before": ["<leader>", "d"], "after": ["d", "d"] },
        { "before": ["<C-n>"], "commands": [":nohl"] },
        { "before": ["K"], "commands": ["lineBreakInsert"], "silent": true }
    ]
}
